{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xair.dev/schemas/action-intent-v1-ai.json",
  "title": "Action Intent Schema (AIS v1 + AI extensions)",
  "description": "Extends AIS v1 with AI producer metadata and the action vocabulary of the evaluated cell; unknown actions are schema violations.",
  "allOf": [
    {
      "$ref": "action-intent-v1.json"
    },
    {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "object",
          "properties": {
            "model_id": {
              "type": "string"
            },
            "prompt_hash": {
              "type": "string"
            },
            "inference_latency_ms": {
              "type": "number",
              "minimum": 0
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "grounded_preconditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "string"
                },
                "image_path": {
                  "type": "string"
                },
                "source_dataset": {
                  "type": "string",
                  "enum": [
                    "visa",
                    "mvtec_ad",
                    "synthetic",
                    "unity"
                  ]
                },
                "category": {
                  "type": "string"
                },
                "scene_hash": {
                  "type": "string"
                },
                "detections": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "payload": {
          "type": "object",
          "properties": {
            "action_type": {
              "type": "string",
              "enum": [
                "ACCEPT",
                "REJECT_TO_BIN",
                "HOLD_FOR_OPERATOR",
                "SLOW_DOWN",
                "RESUME",
                "STOP",
                "E_STOP"
              ]
            }
          }
        }
      }
    }
  ]
}
