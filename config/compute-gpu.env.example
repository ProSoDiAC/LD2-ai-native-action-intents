# Copy to config/compute-gpu.env (gitignored) and adjust locally.
# The L40 and Ollama run on this host, so the defaults point to localhost.
export OLLAMA_HOST=http://127.0.0.1:11434
export OLLAMA_MODEL=${OLLAMA_MODEL:-qwen2.5vl:7b}
# Phase-P runtime knobs read by xair/ai/ollama_client.py (values used in the paper).
export OLLAMA_NUM_CTX=8192
export OLLAMA_TIMEOUT_S=60
export OLLAMA_MAX_RETRIES=2
export OLLAMA_IMAGE_MAX_SIDE=1024
